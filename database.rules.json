{
  "rules": {

    // ── Présence / profils RTDB ──────────────────────────────────────────────
    // Clés encodées depuis l'email (. → ,).
    "users": {
      // ".write" global retiré (DT-07 partiel) : aucun usage légitime n'écrit
      // de champ autre que "name"/"contacts" sous users/{email} (vérifié dans
      // social_service.dart) — la liste de tous les utilisateurs reste lisible
      // (allUsersStream, fonctionnalité de contact existante).
      ".read":  "auth != null",
      "$emailKey": {
        // "name" : tout utilisateur authentifié peut l'initialiser sur le
        // profil d'un tiers (addContact crée un stub de profil par nom),
        // jamais d'autre champ.
        "name": {
          ".write": "auth != null && newData.isString()"
        },
        // Contacts : strictement réservé au propriétaire, en lecture comme en
        // écriture (sendMessage()/addContact() n'écrivent que les contacts de
        // l'utilisateur courant — vérifié, aucun usage légitime n'écrit les
        // contacts d'un tiers).
        "contacts": {
          ".read":  "auth != null && $emailKey == auth.token.email.replace('.', ',')",
          ".write": "auth != null && $emailKey == auth.token.email.replace('.', ',')"
        }
      }
    },

    // ── Statut en ligne ──────────────────────────────────────────────────────
    "status": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Messages ─────────────────────────────────────────────────────────────
    // chatId = "general" | "Classe" | "{encodedEmailA}__{encodedEmailB}" (trié)
    // Seuls les participants d'une conversation privée peuvent la lire/écrire.
    // Les emails sont encodés (. → ,) dans le chatId, via SocialService.encodeKey().
    "messages": {
      "general": {
        ".read":  "auth != null",
        ".write": "auth != null",
        "$msgId": {
          ".validate": "newData.hasChildren(['text','sender','time'])"
        }
      },
      "Classe": {
        ".read":  "auth != null",
        ".write": "auth != null",
        "$msgId": {
          ".validate": "newData.hasChildren(['text','sender','time'])"
        }
      },
      "$chatId": {
        // Accès uniquement si l'email encodé de l'utilisateur fait partie du chatId.
        // chatId = "email1@dom,ain__email2@dom,ain" (les . sont remplacés par ,).
        ".read":  "auth != null && $chatId.contains(auth.token.email.replace('.', ','))",
        ".write": "auth != null && $chatId.contains(auth.token.email.replace('.', ','))",
        "$msgId": {
          ".validate": "newData.hasChildren(['text','sender','time'])"
        }
      }
    },

    // ── Notifications in-app ─────────────────────────────────────────────────
    // Seul le destinataire peut lire ses propres notifications.
    // N'importe quel utilisateur authentifié peut en envoyer (messages entrants).
    "notifications": {
      "$recipientKey": {
        ".read":  "auth != null && $recipientKey == auth.token.email.replace('.', ',')",
        "$notifId": {
          // Création (envoi d'une notification à un tiers, ex. message reçu) :
          // tout utilisateur authentifié peut créer une notification chez le
          // destinataire — restriction complète (limitée aux participants
          // réels d'une conversation) prévue en Phase 2 avec migration RTDB.
          // Modification d'une notification déjà existante (ex. marquage lu) :
          // réservée au destinataire lui-même — aucun tiers ne peut altérer
          // le contenu d'une notification après sa création (DT-07 partiel).
          ".write": "auth != null && (!data.exists() || $recipientKey == auth.token.email.replace('.', ','))",
          ".validate": "newData.hasChildren(['title','body','time'])"
        }
      }
    },

    // ── Amis — DÉSACTIVÉ ─────────────────────────────────────────────────────
    "friends": {
      ".read":  false,
      ".write": false
    },

    // ── Demandes d'amis — DÉSACTIVÉ ─────────────────────────────────────────
    "friend_requests": {
      ".read":  false,
      ".write": false
    },

    // ── Blocages — DÉSACTIVÉ ─────────────────────────────────────────────────
    "blocked": {
      ".read":  false,
      ".write": false
    },

    // ── Professeurs (legacy RTDB) ────────────────────────────────────────────
    "professeurs": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Fallback : refuse tout accès non couvert ─────────────────────────────
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
