rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions helpers ────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Lit le rôle depuis users/{uid} — résultat mis en cache par Firestore
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('role', '');
    }

    function isDirection()  { return isAuth() && role() == 'admin';      }
    function isProfesseur() { return isAuth() && role() == 'professeur'; }
    function isEleve()      { return isAuth() && role() == 'eleve';      }
    function isParent()     { return isAuth() && role() == 'parent';     }

    // Liste des uid enfants stockée dans users/{parentUid}.enfantIds
    function enfantIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('enfantIds', []);
    }

    function isParentOf(eleveUid) {
      return isParent() && eleveUid in enfantIds();
    }

    // ── Profils utilisateurs ─────────────────────────────────────────────────
    match /users/{userId} {
      // Direction lit tout ; professeur lit ses élèves ; propriétaire lit son propre doc
      allow read: if isAuth() && (
        isDirection() ||
        isProfesseur() ||
        isParent() ||
        request.auth.uid == userId
      );

      // Tout utilisateur authentifié peut créer SON propre profil (premier login)
      // Professeur peut créer un profil élève (ajout depuis Gestion des élèves)
      allow create: if isAuth() && (
        request.auth.uid == userId ||
        (isProfesseur() && request.resource.data.get('role', '') == 'eleve')
      );

      // Direction peut tout écrire (création, modification, suppression de n'importe quel compte)
      allow write: if isDirection();

      // Propriétaire peut modifier son profil SANS pouvoir changer son rôle
      allow update: if isAuth() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      // Sous-collections scan (privées au propriétaire)
      match /scan_history/{id}   { allow read, write: if isAuth() && request.auth.uid == userId; }
      match /scan_favorites/{id} { allow read, write: if isAuth() && request.auth.uid == userId; }
    }

    // ── Classes ──────────────────────────────────────────────────────────────
    match /classes/{id} {
      allow read: if isAuth();
      allow create: if isDirection() ||
        (isProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Emploi du temps ──────────────────────────────────────────────────────
    match /emplois_du_temps/{id} {
      allow read: if isAuth();
      allow create: if isDirection() ||
        (isProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Devoirs ──────────────────────────────────────────────────────────────
    match /devoirs/{id} {
      // Élèves et parents lisent les devoirs de leurs classes
      allow read: if isDirection() || isProfesseur() || isEleve() ||
        isParentOf(resource.data.get('classeId', ''));
      allow create: if isDirection() ||
        (isProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Notes ────────────────────────────────────────────────────────────────
    match /notes/{id} {
      // Élève : lit uniquement ses propres notes
      // Parent : lit les notes publiées de ses enfants
      // Professeur : lit les notes qu'il a saisies
      // Direction : accès complet
      allow read: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid) ||
        (isEleve() && resource.data.eleveId == request.auth.uid) ||
        (isParentOf(resource.data.eleveId) && resource.data.publie == true);
      allow create: if isDirection() ||
        (isProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Documents pédagogiques ───────────────────────────────────────────────
    match /documents_prof/{id} {
      allow read: if isAuth();
      allow create: if isDirection() ||
        (isProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Annonces ─────────────────────────────────────────────────────────────
    match /annonces/{id} {
      allow read: if isAuth();
      allow write: if isDirection();
    }

    // ── Copies (devoirs interactifs) ──────────────────────────────────────────
    match /copies/{id} {
      // Élève : accès à ses propres copies
      // Professeur : accès aux copies de ses devoirs
      // Direction : accès complet
      allow read: if isDirection() ||
        (isEleve() && resource.data.eleveId == request.auth.uid) ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid) ||
        isParentOf(resource.data.eleveId);
      allow create: if isEleve() &&
        request.resource.data.eleveId == request.auth.uid;
      allow update: if isDirection() ||
        (isEleve() &&
          resource.data.eleveId == request.auth.uid &&
          resource.data.statut == 'brouillon') ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid);
      allow delete: if isDirection();
    }

    // ── Remises de devoirs ────────────────────────────────────────────────────
    match /submissions/{id} {
      allow read: if isDirection() ||
        resource.data.studentId == request.auth.uid ||
        (isProfesseur() && resource.data.teacherId == request.auth.uid);
      allow create: if isEleve() &&
        request.resource.data.studentId == request.auth.uid;
      allow update: if isDirection() ||
        resource.data.studentId == request.auth.uid ||
        (isProfesseur() && resource.data.teacherId == request.auth.uid);
      allow delete: if isDirection() ||
        (isProfesseur() && resource.data.teacherId == request.auth.uid);
    }

    // ── Présences ────────────────────────────────────────────────────────────
    match /presences/{id} {
      allow read: if isDirection() || isProfesseur() ||
        (isEleve() && resource.data.eleveId == request.auth.uid) ||
        isParentOf(resource.data.eleveId);
      allow create: if isDirection() ||
        (isProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Élèves ────────────────────────────────────────────────────────────────
    match /eleves/{id} {
      allow read: if isAuth();
      allow write: if isDirection();
    }

    // ── Parents ──────────────────────────────────────────────────────────────
    match /parents/{id} {
      allow read: if isDirection() || isProfesseur() ||
        (isParent() && request.auth.uid == id);
      allow write: if isDirection();
    }

    // ── Inscriptions ─────────────────────────────────────────────────────────
    match /inscriptions/{id} {
      allow read, write: if isDirection();
    }

    // ── Compteurs (matricules) ────────────────────────────────────────────────
    match /compteurs/{id} {
      allow read, write: if isDirection();
    }

    // ── Fallback : refuse tout accès non couvert ──────────────────────────────
    match /{document=**} {
      allow read:  if isDirection();
      allow write: if isDirection();
    }
  }
}
