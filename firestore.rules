rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions helpers ────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Lit le rôle depuis users/{uid} — résultat mis en cache par Firestore
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('role', '');
    }

    function isDirection()  {
      return isAuth() && (
        role() == 'admin' ||
        role() == 'direction' ||
        role() == 'adminEtablissement' ||
        role() == 'superAdmin' ||
        request.auth.token.email == 'ilyas31ai@outlook.fr'
      );
    }
    function isProfesseur() { return isAuth() && role() == 'professeur'; }

    // Enseignant actif (rattaché à un établissement)
    function isActiveProfesseur() {
      return isProfesseur() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('teacherStatus', 'active') == 'active';
    }
    function isEleve()      { return isAuth() && role() == 'eleve';      }
    function isParent()     { return isAuth() && role() == 'parent';     }

    // Espace Éditeur (propriétaire SCOLARAI) : accès par liste blanche d'UID,
    // volontairement indépendant du rôle Firestore — voir
    // EditeurAccessService côté client (même liste, à garder synchronisée).
    function isEditeurUid() {
      return isAuth() && request.auth.uid in [
        'of6wqbqQCKdffN7E4N9Od8TZyGX2', // ilyas31ai@outlook.fr — propriétaire SCOLARAI
        'BClcAaJaPOaURt79hmT8dBfQ6M22'  // Compte Éditeur créé le 2026-08-01
      ];
    }

    // Auth UIDs des enfants (stockés dans users/{parentUid}.enfantIds)
    function enfantIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('enfantIds', []);
    }

    // classeIds des enfants (pour filtrer devoirs / emplois du temps)
    function enfantClasseIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('enfantClasseIds', []);
    }

    function isParentOf(eleveUid) {
      return isParent() && eleveUid in enfantIds();
    }

    // Parent peut lire les documents de la classe de son enfant
    function isParentInClass(classeId) {
      return isParent() && classeId in enfantClasseIds();
    }

    // ── Multi-établissements (Phase 2, préparation) ───────────────────────────
    // Ces fonctions ne sont utilisées par AUCUNE règle ci-dessous pour le
    // moment : elles ne changent donc rien au comportement actuel. Elles
    // seront branchées (en mode transition, avec repli sur l'ancienne
    // logique) une fois le backfill `schoolId` confirmé à 100 % sur les
    // données existantes — étape séparée, soumise à validation explicite.
    function mySchoolId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('schoolId', 'ecole_default');
    }
    function sameSchool(data) {
      return isDirection() ||
        data.get('schoolId', 'ecole_default') == mySchoolId();
    }

    // ── Profils utilisateurs ─────────────────────────────────────────────────
    match /users/{userId} {
      // isEditeurUid() : EditeurDashboardPage (EditeurStatsService) fait des
      // requêtes d'agrégation (count()) + une liste triée sur `users`, tous
      // établissements confondus — nécessite un accès en lecture à la
      // collection, pas seulement au document propre.
      allow read: if isAuth() && (
        isDirection() || isProfesseur() || isParent() || isEleve() ||
        isEditeurUid() || request.auth.uid == userId
      );

      // Création : l'utilisateur crée son propre profil.
      // Tout rôle peut s'inscrire librement (sauf admin réservé au superadmin)
      // - eleve / parent : auto-attribution libre
      // - professeur : démarre avec teacherStatus = 'limited'
      // - direction : crée son établissement à l'inscription
      allow create: if isAuth() && (
        // Élève ou parent
        (request.auth.uid == userId &&
          request.resource.data.get('role', '') in ['eleve', 'parent']) ||
        // Enseignant : statut limité obligatoire
        (request.auth.uid == userId &&
          request.resource.data.get('role', '') == 'professeur' &&
          request.resource.data.get('teacherStatus', 'limited') == 'limited') ||
        // Directeur crée son propre compte
        (request.auth.uid == userId &&
          request.resource.data.get('role', '') == 'direction') ||
        // Professeur crée un profil élève
        (isProfesseur() && request.resource.data.get('role', '') == 'eleve')
      );

      // Direction peut tout faire
      allow write: if isDirection();

      // Propriétaire peut modifier son profil avec des restrictions :
      // - Impossible de changer role
      // - Les parents peuvent mettre à jour enfantIds et enfantClasseIds (sync côté client)
      // - Les non-parents ne peuvent pas modifier ces champs sensibles
      allow update: if isAuth() && (
        // Cas 1 : propriétaire modifie son propre profil, sauf role + champs famille
        // + teacherStatus (ne peut être changé qu'en Cas 4)
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role', 'enfantIds', 'enfantClasseIds',
                                    'teacherStatus'])) ||

        // Cas 2 : parent met à jour ses enfantIds/enfantClasseIds (synchronisation)
        (isParent() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['enfantIds', 'enfantClasseIds', 'lastSeen'])) ||

        // Cas 3 : élève lie son uid à enfantIds d'un parent (et la classeId associée)
        (isEleve() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['enfantIds', 'enfantClasseIds']) &&
          request.auth.uid in request.resource.data.get('enfantIds', [])) ||

        // Cas 4 : enseignant utilise un code d'invitation → activation du compte
        // (teacherStatus limited → active, linkedSchool, schoolId, statut)
        // La validation du code est assurée côté service (InvitationService).
        (isProfesseur() && request.auth.uid == userId &&
          resource.data.get('role', '') == 'professeur' &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['teacherStatus', 'linkedSchool',
                                     'linkedSchoolNom', 'schoolId', 'statut']))
      );

      // Maîtrise pédagogique : élève écrit ses propres données, prof/parent/direction lit
      match /maitrise/{notionId} {
        allow read: if isAuth() && (
          isDirection() || isProfesseur() || isParentOf(userId) || request.auth.uid == userId
        );
        allow write: if isAuth() && (isDirection() || request.auth.uid == userId);
      }
    }

    // ── Classes ──────────────────────────────────────────────────────────────
    match /classes/{id} {
      allow read: if isAuth();
      allow create: if isDirection() ||
        (isActiveProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update: if isDirection() ||
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid) ||
        // Professeur actif peut se lier à une classe sans professeur (champs prof uniquement)
        (isActiveProfesseur() &&
          resource.data.get('professeurId', '') == '' &&
          request.resource.data.professeurId == request.auth.uid &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['professeurId', 'professeurEmail',
                                     'professeurDisplayName', 'professeurMatiere'])) ||
        // Élève peut s'ajouter à sa propre classe (première connexion après inscription validée)
        (isEleve() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eleveIds']) &&
          request.auth.uid in request.resource.data.get('eleveIds', []));
      allow delete: if isDirection();
    }

    // ── Emploi du temps ──────────────────────────────────────────────────────
    match /emplois_du_temps/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() || isEleve() ||
        isParentInClass(resource.data.get('classeId', ''))
      );
      allow create: if isDirection() ||
        (isActiveProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Devoirs ──────────────────────────────────────────────────────────────
    match /devoirs/{id} {
      allow read: if isDirection() || isProfesseur() || isEleve() ||
        isParentInClass(resource.data.get('classeId', ''));
      allow create: if isDirection() ||
        (isActiveProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Notes ────────────────────────────────────────────────────────────────
    match /notes/{id} {
      allow read: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid) ||
        // Professeur principal : lit toutes les notes publiées de sa classe
        (isProfesseur() &&
          resource.data.get('classeId', '') != '' &&
          get(/databases/$(database)/documents/classes/$(resource.data.classeId))
            .data.get('professeurId', '') == request.auth.uid) ||
        (isEleve() && resource.data.eleveId == request.auth.uid) ||
        (isParentOf(resource.data.eleveId) && resource.data.publie == true);
      allow create: if isDirection() ||
        (isActiveProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Documents pédagogiques ───────────────────────────────────────────────
    match /documents_prof/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() || isEleve() ||
        isParentInClass(resource.data.get('classeId', ''))
      );
      allow create: if isDirection() ||
        (isActiveProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Annonces ─────────────────────────────────────────────────────────────
    match /annonces/{id} {
      allow read: if isAuth();
      allow write: if isDirection();
    }

    // ── Copies (devoirs interactifs) ──────────────────────────────────────────
    match /copies/{id} {
      allow read: if isAuth() && (
        isDirection() ||
        (isEleve() && resource.data.eleveId == request.auth.uid) ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid) ||
        isParentOf(resource.data.eleveId)
      );
      // L'élève crée sa copie : eleveId doit être son uid, professeurId doit être renseigné
      allow create: if isEleve() &&
        request.resource.data.eleveId == request.auth.uid &&
        request.resource.data.get('professeurId', '') is string;
      // L'élève peut modifier sa copie uniquement si elle est encore en brouillon
      allow update: if isDirection() ||
        (isEleve() &&
          resource.data.eleveId == request.auth.uid &&
          resource.data.statut == 'brouillon' &&
          // Interdit de changer l'identifiant du devoir ou de l'élève
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['devoirId', 'eleveId'])) ||
        // Prof actif peut corriger / ajouter sa note
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eleveId', 'devoirId']));
      allow delete: if isDirection();
    }

    // ── Remises de devoirs ────────────────────────────────────────────────────
    match /submissions/{id} {
      allow read: if isAuth() && (
        isDirection() ||
        (isEleve() && resource.data.studentId == request.auth.uid) ||
        (isProfesseur() && resource.data.teacherId == request.auth.uid) ||
        isParentOf(resource.data.studentId)
      );
      allow create: if isEleve() &&
        request.resource.data.studentId == request.auth.uid;
      allow update: if isDirection() ||
        // L'élève peut mettre à jour sa remise (resoumission)
        (isEleve() && resource.data.studentId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'assignmentId'])) ||
        // Le prof actif peut annoter / changer le statut
        (isActiveProfesseur() && resource.data.teacherId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'assignmentId']));
      allow delete: if isDirection() ||
        (isActiveProfesseur() && resource.data.teacherId == request.auth.uid);
    }

    // ── Présences ────────────────────────────────────────────────────────────
    match /presences/{id} {
      allow read: if isAuth() && (
        isDirection() ||
        isProfesseur() ||
        (isEleve() && resource.data.eleveId == request.auth.uid) ||
        isParentOf(resource.data.eleveId)
      );
      allow create: if isDirection() ||
        (isActiveProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow update, delete: if isDirection() ||
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Élèves ────────────────────────────────────────────────────────────────
    // FIX : les fiches élèves contiennent des données personnelles sensibles
    // (adresse, parents, contact d'urgence). Accès restreint.
    match /eleves/{id} {
      allow read: if isAuth() && (
        isDirection() ||
        isProfesseur() ||
        // L'élève peut lire sa propre fiche (identifiée par email ou authUid)
        (isEleve() && (
          resource.data.get('authUid', '') == request.auth.uid ||
          resource.data.get('email', '') ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '')
        )) ||
        // Parent peut lire les fiches de ses enfants
        isParentOf(resource.data.get('authUid', ''))
      );
      allow write: if isDirection();

      // L'élève lie son propre authUid à sa fiche au premier login (uniquement
      // ce champ), pour que profs/parents puissent ensuite le retrouver par uid.
      allow update: if isAuth() && isEleve() &&
        resource.data.get('email', '') == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']) &&
        request.resource.data.get('authUid', '') == request.auth.uid;
    }

    // ── Parents ──────────────────────────────────────────────────────────────
    match /parents/{id} {
      // Auto-détection du rôle au premier login : un utilisateur peut lire la
      // fiche parent correspondant à SA PROPRE adresse email (vérifiée par Auth),
      // même avant que son profil users/{uid} (et donc son rôle) n'existe.
      allow read: if isDirection() || isProfesseur() ||
        (isAuth() && resource.data.get('email', '') == request.auth.token.email);
      allow write: if isDirection();
    }

    // ── RDV Scolaires ─────────────────────────────────────────────────────────
    match /rdv/{id} {
      allow read: if isAuth() && (
        isDirection() ||
        resource.data.parentUid == request.auth.uid ||
        resource.data.professeurId == request.auth.uid
      );
      allow create: if isParent() &&
        request.resource.data.parentUid == request.auth.uid;

      // FIX CRITIQUE : chaque acteur ne peut modifier que ses propres champs
      allow update: if isDirection() ||

        // Parent : peut uniquement annuler sa demande ou confirmer une contre-proposition
        (isAuth() && resource.data.parentUid == request.auth.uid &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['statut', 'updatedAt']) &&
          request.resource.data.statut in ['annule', 'confirme'] &&
          // Confirmer seulement si le prof a proposé une autre date
          (request.resource.data.statut != 'confirme' ||
            resource.data.statut == 'propose_autre_date')) ||

        // Professeur : peut accepter, refuser, proposer une autre date
        (isAuth() && resource.data.professeurId == request.auth.uid &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['statut', 'notesProfesseur', 'contrePropositionDate', 'updatedAt']) &&
          request.resource.data.statut in ['accepte', 'refuse', 'propose_autre_date']);

      allow delete: if isDirection() ||
        (isAuth() && resource.data.parentUid == request.auth.uid);
    }

    // ── Quotas IA ─────────────────────────────────────────────────────────────
    match /quotas/{docId} {
      // docId = "{uid}_{YYYYMMDD}" — chaque utilisateur gère son propre quota
      // La regex vérifie que le docId COMMENCE par l'uid de l'utilisateur connecté
      allow read: if isAuth() && docId.matches(request.auth.uid + '_[0-9]{8}');
      // Création : uniquement le premier appel de la journée (count == 1)
      allow create: if isAuth() && docId.matches(request.auth.uid + '_[0-9]{8}') &&
        request.resource.data.count == 1;
      // Mise à jour : incrément strict de 1, aucun autre champ modifiable
      // (empêche la remise à zéro ou la falsification du quota par le client)
      allow update: if isAuth() && docId.matches(request.auth.uid + '_[0-9]{8}') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count == resource.data.count + 1;
      // Direction peut lire tous les quotas (supervision)
      allow read: if isDirection();
    }

    // ── Validations de bulletins (publication par la Direction) ──────────────
    match /bulletin_validations/{id} {
      // Tout utilisateur authentifié peut lire (pour afficher le badge)
      allow read: if isAuth();
      // Seule la Direction peut publier / dépublier
      allow create, update, delete: if isDirection();
    }

    // ── Appréciations de bulletins ───────────────────────────────────────────
    match /appreciations/{id} {
      allow read: if isDirection() ||
        (isProfesseur() && resource.data.professeurId == request.auth.uid) ||
        // Professeur principal : lit toutes les appréciations de sa classe
        (isProfesseur() &&
          resource.data.get('classeId', '') != '' &&
          get(/databases/$(database)/documents/classes/$(resource.data.classeId))
            .data.get('professeurId', '') == request.auth.uid) ||
        (isEleve() && resource.data.eleveId == request.auth.uid) ||
        isParentOf(resource.data.eleveId);
      allow create, update: if isDirection() ||
        (isActiveProfesseur() && request.resource.data.professeurId == request.auth.uid);
      allow delete: if isDirection() ||
        (isActiveProfesseur() && resource.data.professeurId == request.auth.uid);
    }

    // ── Récapitulatif bulletins (prof principal) ──────────────────────────────
    match /bulletins_recap/{id} {
      // Tous les utilisateurs authentifiés peuvent lire (élèves, parents, direction)
      allow read: if isAuth();
      // Création : le prof actif qui est professeurId de la classe
      allow create: if isActiveProfesseur() &&
        request.resource.data.get('classeId', '') != '' &&
        get(/databases/$(database)/documents/classes/$(request.resource.data.classeId))
          .data.get('professeurId', '') == request.auth.uid;
      // Mise à jour : même vérification sur la classe existante
      allow update: if isActiveProfesseur() &&
        resource.data.get('classeId', '') != '' &&
        get(/databases/$(database)/documents/classes/$(resource.data.classeId))
          .data.get('professeurId', '') == request.auth.uid;
      allow delete: if isDirection();
    }

    // ── Codes d'invitation enseignants ───────────────────────────────────────
    match /teacher_invitations/{invId} {
      // Lecture : tout utilisateur authentifié (pour valider son propre code)
      allow read: if isAuth();
      // Création : Direction uniquement
      allow create: if isDirection();
      // Mise à jour : Direction (révocation) OU enseignant ciblé (utilisation)
      allow update: if isDirection() || (
        isAuth() &&
        // Ne peut modifier que used/usedAt/teacherUid (marquage utilisation)
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['used', 'usedAt', 'teacherUid']) &&
        // Seul l'enseignant pour lequel le code a été généré (ou code générique)
        (resource.data.get('teacherUid', '') == '' ||
         resource.data.get('teacherUid', '') == request.auth.uid)
      );
      // Suppression : Direction uniquement
      allow delete: if isDirection();
    }

    // ── Inscriptions ─────────────────────────────────────────────────────────
    match /inscriptions/{id} {
      allow read, write: if isDirection();
    }

    // ── Compteurs (matricules) ────────────────────────────────────────────────
    match /compteurs/{id} {
      allow read, write: if isDirection();
    }

    // ── Messagerie interne (conversations + messages) ────────────────────────
    match /conversations/{convId} {
      // Lecture : être participant (ou doc inexistant, pour permettre le
      // get() de vérification dans getOrCreateDirect avant création)
      allow read: if isAuth() &&
        (!exists(/databases/$(database)/documents/conversations/$(convId)) ||
          request.auth.uid in resource.data.get('participantIds', []));
      // Création : inclure son propre uid + au moins 2 participants
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.get('participantIds', []) &&
        request.resource.data.get('participantIds', []).size() >= 2;
      // Mise à jour : être participant (pour unreadCounts, archive, pinned…)
      allow update: if isAuth() &&
        request.auth.uid in resource.data.get('participantIds', []);
      // Suppression : Direction uniquement
      allow delete: if isDirection();

      match /messages/{msgId} {
        allow read: if isAuth() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId))
              .data.get('participantIds', []);
        allow create: if isAuth() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId))
              .data.get('participantIds', []) &&
          request.resource.data.get('senderId', '') == request.auth.uid;
        // Mise à jour : expéditeur (suppression, etc.) ou Direction
        allow update: if isDirection() ||
          (isAuth() && resource.data.get('senderId', '') == request.auth.uid) ||
          // Mise à jour readBy : tout participant peut s'y ajouter
          (isAuth() &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(convId))
                .data.get('participantIds', []) &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['readBy']));
        allow delete: if isDirection();
      }
    }

    // ── Établissements ──────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if isAuth();
      // Directeur crée son établissement lors de l'inscription (schoolId == uid)
      allow create: if isAuth() &&
        schoolId == request.auth.uid &&
        request.resource.data.get('directeurId', '') == request.auth.uid;
      allow update, delete: if isDirection();
    }

    // ── Disponibilités enseignants (remplacements) ───────────────────────────
    // doc id = uid de l'enseignant
    match /disponibilites/{uid} {
      allow read: if isAuth() && (isDirection() || isProfesseur());
      allow write: if isDirection() ||
        (isActiveProfesseur() && uid == request.auth.uid);

      match /absences/{absId} {
        allow read: if isAuth() && (isDirection() || isProfesseur());
        allow write: if isDirection() ||
          (isActiveProfesseur() && uid == request.auth.uid);
      }
    }

    // ── Remplacements ─────────────────────────────────────────────────────────
    match /remplacements/{id} {
      allow read: if isAuth() && (isDirection() || isProfesseur());
      allow create: if isDirection() || isActiveProfesseur();
      allow update: if isDirection() || isActiveProfesseur();
      allow delete: if isDirection();
    }

    // ── Profils enseignants étendus (fiche consultée par la Direction) ───────
    match /enseignants_profils/{uid} {
      allow read: if isAuth() && (isDirection() || isProfesseur());
      allow write: if isDirection();
    }

    // ── Dossiers enseignants (rempli par l'enseignant lui-même) ──────────────
    match /enseignant_dossiers/{uid} {
      allow read: if isAuth() &&
        (isDirection() || uid == request.auth.uid);
      allow write: if isDirection() ||
        (isActiveProfesseur() && uid == request.auth.uid);
    }

    // ── Évaluations qualitatives (maternelle) ────────────────────────────────
    match /evaluations_qualitatives/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('eleveId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('eleveId', ''))
      );
      allow write: if isDirection() || isActiveProfesseur();
    }

    // ── Cahier de vie / observations / repas / sieste (maternelle) ───────────
    match /cahier_vie/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('eleveId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('eleveId', ''))
      );
      allow write: if isDirection() || isActiveProfesseur();
    }
    match /observations/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('eleveId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('eleveId', ''))
      );
      allow write: if isDirection() || isActiveProfesseur();
    }
    match /repas_maternelle/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('eleveId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('eleveId', ''))
      );
      allow write: if isDirection() || isActiveProfesseur();
    }
    match /sieste_maternelle/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('eleveId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('eleveId', ''))
      );
      allow write: if isDirection() || isActiveProfesseur();
    }
    match /competences_maternelle/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('eleveId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('eleveId', ''))
      );
      allow write: if isDirection() || isActiveProfesseur();
    }

    // ── Galerie photos / événements de classe (maternelle) ───────────────────
    // Scoping par classeNom (pas de donnée personnelle sensible individuelle)
    match /galerie_photos/{id} {
      allow read: if isAuth();
      allow write: if isDirection() || isActiveProfesseur();
    }
    match /evenements_maternelle/{id} {
      allow read: if isAuth();
      allow write: if isDirection() || isActiveProfesseur();
    }

    // ── Documents pédagogiques publiés pour une classe ───────────────────────
    match /documents_pedagogiques/{id} {
      allow read: if isAuth();
      allow write: if isDirection() || isActiveProfesseur();
    }

    // ── Messages enseignant → parents (maternelle) ───────────────────────────
    match /messages_parents/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('eleveId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('eleveId', ''))
      );
      allow create, delete: if isDirection() || isActiveProfesseur();
      allow update: if isDirection() || isActiveProfesseur() ||
        (isParentOf(resource.data.get('eleveId', '')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']));
    }

    // ── Révision (élève) : sessions + statistiques personnelles ──────────────
    match /revision_sessions/{uid} {
      allow read, write: if isDirection() || uid == request.auth.uid;
      match /sessions/{sessionId} {
        allow read, write: if isDirection() || uid == request.auth.uid;
      }
    }
    match /revision_stats/{uid} {
      allow read, write: if isDirection() || uid == request.auth.uid;
    }

    // ── Université : mémoires / soutenances / stages (lecture élève) ─────────
    match /memoires/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('etudiantId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('etudiantId', ''))
      );
      allow write: if isDirection();
    }
    match /soutenances/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('etudiantId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('etudiantId', ''))
      );
      allow write: if isDirection();
    }
    match /stages/{id} {
      allow read: if isAuth() && (
        isDirection() || isProfesseur() ||
        (isEleve() && resource.data.get('etudiantId', '') == request.auth.uid) ||
        isParentOf(resource.data.get('etudiantId', ''))
      );
      allow write: if isDirection();
    }

    // ── Référentiels globaux (cycles / niveaux scolaires) ────────────────────
    match /cycles/{id} {
      allow read: if isAuth();
      allow write: if isDirection();
    }
    match /niveaux/{id} {
      allow read: if isAuth();
      allow write: if isDirection();
    }

    // ── Brouillons d'inscription (outil assistant Direction) ─────────────────
    match /inscription_wizards/{id} {
      allow read, write: if isDirection();
    }

    // ── SCOLAR Connect : groupes d'étude, partages, salles ───────────────────
    match /scolar_groupes/{groupeId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.get('creatorUid', '') == request.auth.uid;
      allow update: if isDirection() ||
        (isAuth() &&
          exists(/databases/$(database)/documents/scolar_groupes/$(groupeId)/membres/$(request.auth.uid)));
      allow delete: if isDirection() ||
        resource.data.get('creatorUid', '') == request.auth.uid;

      match /membres/{uid} {
        allow read: if isAuth();
        allow write: if isDirection() || uid == request.auth.uid;
      }
      match /documents/{docId} {
        allow read: if isAuth();
        allow write: if isDirection() ||
          exists(/databases/$(database)/documents/scolar_groupes/$(groupeId)/membres/$(request.auth.uid));
      }
    }
    match /scolar_partages/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isDirection() ||
        resource.data.get('auteurEmail', '') == request.auth.token.email;
    }
    match /scolar_salles/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── Support & Suggestions ────────────────────────────────────────────────
    // Tout utilisateur authentifié peut créer une demande (bug, suggestion,
    // question, avis) sur son propre uid ; seule la Direction consulte et
    // traite l'ensemble des demandes (statut, réponse interne — voir
    // SupportService). L'auteur peut relire sa propre demande mais ne peut
    // pas la modifier après envoi : toute correction passe par la Direction.
    match /support_tickets/{id} {
      allow read: if isDirection() || isEditeurUid() ||
        (isAuth() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('statut', '') == 'nouveau';
      // Éditeur : mêmes droits de traitement que la Direction sur ce
      // module (répondre, changer le statut — voir EditeurSupportPage qui
      // réutilise SupportTicketDetailView), sans fusionner isEditeurUid()
      // dans isDirection().
      allow update, delete: if isDirection() || isEditeurUid();
    }

    // ── Espace Éditeur — abonnements & paiements (Phase future) ──────────────
    // Structure préparée dès maintenant (voir SubscriptionModel) mais aucune
    // UI ne l'exploite encore. Un document par établissement, id = schoolId.
    // Volontairement PAS accessible à isDirection() : espace totalement
    // séparé des établissements, réservé au propriétaire de la plateforme.
    match /subscriptions/{schoolId} {
      allow read, write: if isEditeurUid();
    }

    // ── Fallback : refuse tout accès non couvert ──────────────────────────────
    match /{document=**} {
      allow read:  if isDirection();
      allow write: if isDirection();
    }
  }
}
